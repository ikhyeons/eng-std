{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/main.ts": {
      "includeFiles": "products/version.txt"
    }
  },
  "headers": [
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        }
      ]
    }
  ]
}
