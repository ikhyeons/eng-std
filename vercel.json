{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"PJ-Electron-Setup-1.0.0.exe.zip\""
        }
      ]
    }
  ],
  "outputFileTracingIncludes": {
    "src/**": ["./public/downloads/**"]
  }
}
